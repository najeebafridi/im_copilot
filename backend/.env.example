PROJECT_NAME=IM Copilot
API_V1_PREFIX=/api/v1
DEBUG=True

DATABASE_URL=sqlite:///./im_copilot.db
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DOCUMENTS_PATH=documents
CHROMA_PATH=data/chroma
EMBEDDING_MODEL=local-hash-embedding
CHUNK_SIZE=800
CHUNK_OVERLAP=120
COPILOT_TOP_K=5

MOCK_LLM=True
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256

ENABLE_CACHE=True
CACHE_SIZE=100
ROUTER_DEBUG=False

CHAT_MEMORY_ENABLED=True
CHAT_TTL_HOURS=24
CHAT_MAX_CONVERSATIONS_PER_USER=30
CHAT_MAX_MESSAGES_PER_CONVERSATION=200
CHAT_CLEANUP_INTERVAL_MINUTES=30
CHAT_MAX_TITLE_LENGTH=40
